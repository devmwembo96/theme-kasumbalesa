// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

BULLISH_LEG                     = 1
BEARISH_LEG                     = 0

GREEN                           = #089981
RED                             = #F23645
BLUE                            = #2157f3
GRAY                            = #878b94
MONO_BULLISH                    = #b2b5be
MONO_BEARISH                    = #5d606b

HISTORICAL                      = 'Historical'
PRESENT                         = 'Present'

COLORED                         = 'Colored'
MONOCHROME                      = 'Monochrome'

TINY                            = size.tiny
SMALL                           = size.small
NORMAL                          = size.normal

SOLID                           = '⎯⎯⎯'
DASHED                          = '----'
DOTTED                          = '····'

SMART_GROUP                     = 'Smart Money Concepts'
SWING_GROUP                     = 'EQH/EQL'
EQUAL_GROUP                     = 'EQH/EQL'
modeTooltip                     = 'Allows to display historical Structure or only the recent ones'
styleTooltip                    = 'Indicator color theme'
showSwingsTooltip               = 'Display swing point as labels on the chart'
showEqualHighsLowsTooltip       = 'Display equal highs and equal lows on the chart'
equalHighsLowsLengthTooltip     = 'Number of bars used to confirm equal highs and equal lows'
equalHighsLowsThresholdTooltip  = 'Sensitivity threshold in a range (0, 1) used for the detection of equal highs & lows\n\nLower values will return fewer but more pertinent results'
showPremiumDiscountZonesTooltip = 'Display premium, discount, and equilibrium zones on chart'

modeInput                       = input.string( HISTORICAL, 'Mode',                     group = SMART_GROUP,    tooltip = modeTooltip, options = [HISTORICAL, PRESENT])
styleInput                      = input.string( COLORED,    'Style',                    group = SMART_GROUP,    tooltip = styleTooltip,options = [COLORED, MONOCHROME])
swingBullColorInput             = input(        GREEN,      'Swing Bullish Color',      group = SWING_GROUP)
swingBearColorInput             = input(        RED,        'Swing Bearish Color',      group = SWING_GROUP)
showSwingsInput                 = false
showEqualHighsLowsInput         = input(        true,       'Equal High/Low',           group = EQUAL_GROUP,    tooltip = showEqualHighsLowsTooltip)
equalHighsLowsLengthInput       = input.int(    3,          'Bars Confirmation',        group = EQUAL_GROUP,    tooltip = equalHighsLowsLengthTooltip,      minval = 1)
equalHighsLowsThresholdInput    = input.float(  0.1,        'Threshold',                group = EQUAL_GROUP,    tooltip = equalHighsLowsThresholdTooltip,   minval = 0, maxval = 0.5, step = 0.1)
equalHighsLowsSizeInput         = input.string( TINY,       'Label Size',               group = EQUAL_GROUP,    options = [TINY,SMALL,NORMAL])

// @type                            UDT representing last swing extremes (top & bottom)
// @field top                       last top swing price
// @field bottom                    last bottom swing price
// @field barTime                   last swing bar time
// @field barIndex                  last swing bar index
// @field lastTopTime               last top swing time
// @field lastBottomTime            last bottom swing time
type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

// @type                            UDT representing Equal Highs Lows display
// @field l_ine                     displayed line
// @field l_abel                    displayed label
type equalDisplay
    line l_ine      = na
    label l_abel    = na

// @type                            UDT representing a pivot point (swing point) 
// @field currentLevel              current price level
// @field lastLevel                 last price level
// @field crossed                   true if price level is crossed
// @field barTime                   bar time
// @field barIndex                  bar index    
type pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime     = time
    int barIndex    = bar_index

// @type                            UDT representing alerts as bool fields
// @field equalHighs                equal high low custom alert
// @field equalLows                 equal high low custom alert
type alerts
    bool equalHighs                 = false
    bool equalLows                  = false

var pivot swingHigh                 = pivot.new(na,na,false)
// @variable                        current swing pivot low
var pivot swingLow                  = pivot.new(na,na,false)
// @variable                        current internal pivot high
var pivot internalHigh              = pivot.new(na,na,false)
// @variable                        current internal pivot low
var pivot internalLow               = pivot.new(na,na,false)
// @variable                        current equal high pivot
var pivot equalHigh                 = pivot.new(na,na,false)
// @variable                        current equal low pivot
var pivot equalLow                  = pivot.new(na,na,false)
var equalDisplay equalHighDisplay   = equalDisplay.new()
// @variable                        equal low display
var equalDisplay equalLowDisplay    = equalDisplay.new()
var array<float> highs              = array.new<float>()
// @variable                        storage for raw lows
var array<float> lows               = array.new<float>()
// @variable                        storage for bar time values
var array<int> times                = array.new<int>()
var trailingExtremes trailing       = trailingExtremes.new()
var swingBullishColor               = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
// @variable                        color for swing bearish structures
var swingBearishColor               = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
varip int currentBarIndex           = bar_index
// @variable                        bar index on last script iteration
varip int lastBarIndex              = bar_index
// @variable                        alerts in current bar
alerts currentAlerts                = alerts.new()
// @variable                        time at start of chart
var initialTime                     = time

atrMeasure                          = ta.atr(200)

// we store current values into the arrays at each bar
highs.push(high)
lows.push(low)
times.push(time)

// @function            Get the value of the current leg, it can be 0 (bearish) or 1 (bullish)
// @returns             int
leg(int size) =>
    var leg     = 0    
    newLegHigh  = high[size] > ta.highest( size)
    newLegLow   = low[size]  < ta.lowest(  size)
    
    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

// @function            Identify whether the current value is the start of a new leg (swing)
// @param leg           (int) Current leg value
// @returns             bool
startOfNewLeg(int leg)      => ta.change(leg) != 0

// @function            Identify whether the current level is the start of a new bearish leg (swing)
// @param leg           (int) Current leg value
// @returns             bool
startOfBearishLeg(int leg)  => ta.change(leg) == -1

// @function            Identify whether the current level is the start of a new bullish leg (swing)
// @param leg           (int) Current leg value
// @returns             bool
startOfBullishLeg(int leg)  => ta.change(leg) == +1

// @function            create a new label
// @param labelTime     bar time coordinate
// @param labelPrice    price coordinate
// @param tag           text to display
// @param labelColor    text color
// @param labelStyle    label style
// @returns             label ID
drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>    
    var label l_abel = na

    if modeInput == PRESENT
        l_abel.delete()

    l_abel := label.new(chart.point.new(labelTime,na,labelPrice),tag,xloc.bar_time,color=color(na),textcolor=labelColor,style = labelStyle,size = size.small)

// @function            create a new line and label representing an EQH or EQL
// @param p_ivot        starting pivot
// @param level         price level of current pivot
// @param size          how many bars ago was the current pivot detected
// @param equalHigh     true for EQH, false for EQL
// @returns             label ID
drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay
    
    string tag          = 'EQL'
    color equalColor    = swingBullishColor
    string labelStyle   = label.style_label_up

    if equalHigh
        tag         := 'EQH'
        equalColor  := swingBearishColor
        labelStyle  := label.style_label_down

    if modeInput == PRESENT
        line.delete(    e_qualDisplay.l_ine)
        label.delete(   e_qualDisplay.l_abel)
        
    e_qualDisplay.l_ine     := line.new(chart.point.new(p_ivot.barTime,na,p_ivot.currentLevel), chart.point.new(time[size],na,level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
    labelPosition           = math.round(0.5*(p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel    := label.new(chart.point.new(na,labelPosition,level), tag, xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput)

// @function            store current structure and trailing swing points, and also display swing points and equal highs/lows
// @param size          (int) structure size
// @param equalHighLow  (bool) true for displaying current highs/lows
// @param internal      (bool) true for getting internal structures
// @returns             label ID
getCurrentStructure(int size,bool equalHighLow = false, bool internal = false) =>        
    currentLeg              = leg(size)
    newPivot                = startOfNewLeg(currentLeg)
    pivotLow                = startOfBullishLeg(currentLeg)
    pivotHigh               = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p_ivot    = equalHighLow ? equalLow : internal ? internalLow : swingLow    

            if equalHighLow and showEqualHighsLowsInput and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure                
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.bottom         := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)            
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh

            if equalHighLow and showEqualHighsLowsInput and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot,high[size],size,true)
                currentAlerts.equalHighs := true               

            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]

            if not equalHighLow and not internal
                trailing.top            := p_ivot.currentLevel
                trailing.barTime        := p_ivot.barTime
                trailing.barIndex       := p_ivot.barIndex
                trailing.lastTopTime    := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)

//---------------------------------------------------------------------------------------------------------------------{
//EXECUTION (EQH/EQL)
//---------------------------------------------------------------------------------------------------------------------{
getCurrentStructure(equalHighsLowsLengthInput,true)

alertcondition(currentAlerts.equalHighs,                'Equal Highs',                  'Equal highs detected')
alertcondition(currentAlerts.equalLows,                 'Equal Lows',                   'Equal lows detected')



// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
//  AJOUT 2 — FVG Instantaneous Mitigation Signals (IMFVG)
//  © LuxAlgo (CC BY-NC-SA 4.0) — zone, moyenne et repère ▲▼ ; TP/SL, trailing stop et barcolor retirés
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

filterWidth = input.float(0., 'FVG Width Filter', minval = 0, step = .1, group = 'IMFVG')
imfvgOnClose = input.bool(true, 'Signaux validés à la clôture de bougie (sans scintillement)', group = 'IMFVG')
imfvgOK = not imfvgOnClose or barstate.isconfirmed

//Style
showBull = input(true, 'Bullish IMFVG', inline = 'bull', group = 'IMFVG · Style')
bullCss = input(color.teal, '', inline = 'bull', group = 'IMFVG · Style')
bullAvg = input(true, 'Average', inline = 'bull', group = 'IMFVG · Style')

showBear = input(true, 'Bearish IMFVG', inline = 'bear', group = 'IMFVG · Style')
bearCss = input(#f23645, '', inline = 'bear', group = 'IMFVG · Style')
bearAvg = input(true, 'Average', inline = 'bear', group = 'IMFVG · Style')

//---------------------------------------------------------------------------------------------------------------------}
//Functions
//---------------------------------------------------------------------------------------------------------------------{
n = bar_index
atr = nz(ta.atr(200))

filter(a, b)=> a - b > atr * filterWidth

//---------------------------------------------------------------------------------------------------------------------}
//Signals
//---------------------------------------------------------------------------------------------------------------------{
var line bull_line    = na
var bool bull_lvl_reached = bool(na)
var line bear_line    = na
var bool bear_lvl_reached = bool(na)

var os = 0

//Bullish Signals
bull = low[3] > high[1] and close[2] < low[3] and close > low[3] and filter(low[3], high[1]) and showBull and imfvgOK

//Set bullish tpsl zones
if bull
    //Imbalance area
    box.new(n-3, low[3], n, high[1], na, bgcolor = color.new(bullCss, 50))
    avg = math.avg(low[3], high[1])

    //Imbalance area average
    if bullAvg
        bull_line := line.new(n, avg, n, avg, color = bullCss, style = line.style_dashed)

    //Label
    label.new(n, low, '▲', color = color(na), textcolor = bullCss, style = label.style_label_up, size = size.small)

    os := 1
    bull_lvl_reached := false

//Bearish Signals
bear = low[1] > high[3] and close[2] > high[3] and close < high[3] and filter(low[1], high[3]) and showBear and imfvgOK

//Set bearish tpsl zones
if bear
    //Imbalance area
    box.new(n-3, low[1], n, high[3], na, bgcolor = color.new(bearCss, 50))
    avg = math.avg(low[1], high[3])
    
    //Imbalance area average
    if bearAvg
        bear_line := line.new(n, avg, n, avg, color = bearCss, style = line.style_dashed)

    //Label
    label.new(n, high, '▼', color = color(na), textcolor = bearCss, style = label.style_label_down, size = size.small)

    os := 0
    bear_lvl_reached := false

//Extend average imabalance areas
if not bull_lvl_reached
    bull_line.set_x2(n)
if not bear_lvl_reached
    bear_line.set_x2(n)

//Test if reached
if close < bull_line.get_y2()
    bull_lvl_reached := true

if close > bear_line.get_y2()
    bear_lvl_reached := true

// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
//  AJOUT 6 — Liquidity Defense Zones (LDZ) by JPT  © Jos-ProTrader (MPL 2.0)
//  Code intact, tous les réglages d'origine. Variables préfixées ldz_ pour éviter les collisions.
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 1. INPUTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ldz_groupLiquidity = "Liquidity Engine"

ldz_pivotLen = input.int(28, "Pivot Strength", minval=2, group=ldz_groupLiquidity)
ldz_atrLen = input.int(14, "ATR Length", minval=1, group=ldz_groupLiquidity)
ldz_zoneAtrMult = input.float(0.20, "Zone Thickness (ATR)", minval=0.05, step=0.05, group=ldz_groupLiquidity)
ldz_maxZones = input.int(15, "Maximum Zones Per Side", minval=1, maxval=50, group=ldz_groupLiquidity)

ldz_groupDisplay = "Display Settings"

ldz_showZones = input.bool(true, "Show Liquidity Zones", group=ldz_groupDisplay)
ldz_showLabels = input.bool(true, "Show BSL / SSL Labels", group=ldz_groupDisplay)
ldz_showSweeps = input.bool(true, "Show Sweep Signals", group=ldz_groupDisplay)
ldz_extendZones = input.bool(true, "Extend Active Zones", group=ldz_groupDisplay)

ldz_groupSignals = "Reversal Confirmation"

ldz_requireCandleColor = input.bool(true, "Require Reversal Candle", group=ldz_groupSignals)
ldz_showReversals = input.bool(true, "Show Reversal Signals", group=ldz_groupSignals)

ldz_groupAlerts = "Alerts"

ldz_enableAlerts = input.bool(true, "Enable Alerts", group=ldz_groupAlerts)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 2. ATR & CONFIRMED PIVOTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ldz_atr = ta.atr(ldz_atrLen)
ldz_zoneSize = ldz_atr * ldz_zoneAtrMult

ldz_pivotHigh = ta.pivothigh(high, ldz_pivotLen, ldz_pivotLen)
ldz_pivotLow = ta.pivotlow(low, ldz_pivotLen, ldz_pivotLen)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 3. LIQUIDITY STORAGE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

var box[] ldz_bslZones = array.new_box()
var box[] ldz_sslZones = array.new_box()

var float[] ldz_bslPrices = array.new_float()
var float[] ldz_sslPrices = array.new_float()

var bool[] ldz_bslActive = array.new_bool()
var bool[] ldz_sslActive = array.new_bool()

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 4. CREATE BUY-SIDE LIQUIDITY ZONES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if not na(ldz_pivotHigh) and not na(ldz_zoneSize[ldz_pivotLen])

    float level = ldz_pivotHigh
    float thickness = ldz_zoneSize[ldz_pivotLen]

    box newZone = box.new(
         left=bar_index - ldz_pivotLen,
         top=level + thickness,
         right=bar_index,
         bottom=level - thickness,
         xloc=xloc.bar_index,
         extend=ldz_extendZones ? extend.right : extend.none,
         border_color=ldz_showZones ? color.red : color.new(color.red, 100),
         bgcolor=ldz_showZones ? color.new(color.red, 88) : color.new(color.red, 100))

    array.push(ldz_bslZones, newZone)
    array.push(ldz_bslPrices, level)
    array.push(ldz_bslActive, true)

    if ldz_showLabels
        label.new(
             bar_index - ldz_pivotLen,
             level + thickness,
             "BSL",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.tiny)

    if array.size(ldz_bslZones) > ldz_maxZones
        box oldZone = array.shift(ldz_bslZones)
        box.delete(oldZone)
        array.shift(ldz_bslPrices)
        array.shift(ldz_bslActive)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 5. CREATE SELL-SIDE LIQUIDITY ZONES
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if not na(ldz_pivotLow) and not na(ldz_zoneSize[ldz_pivotLen])

    float level = ldz_pivotLow
    float thickness = ldz_zoneSize[ldz_pivotLen]

    box newZone = box.new(
         left=bar_index - ldz_pivotLen,
         top=level + thickness,
         right=bar_index,
         bottom=level - thickness,
         xloc=xloc.bar_index,
         extend=ldz_extendZones ? extend.right : extend.none,
         border_color=ldz_showZones ? color.lime : color.new(color.lime, 100),
         bgcolor=ldz_showZones ? color.new(color.lime, 88) : color.new(color.lime, 100))

    array.push(ldz_sslZones, newZone)
    array.push(ldz_sslPrices, level)
    array.push(ldz_sslActive, true)

    if ldz_showLabels
        label.new(
             bar_index - ldz_pivotLen,
             level - thickness,
             "SSL",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.tiny)

    if array.size(ldz_sslZones) > ldz_maxZones
        box oldZone = array.shift(ldz_sslZones)
        box.delete(oldZone)
        array.shift(ldz_sslPrices)
        array.shift(ldz_sslActive)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 6. LIQUIDITY SWEEP ENGINE
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

bool ldz_bullishSweep = false
bool ldz_bearishSweep = false

if array.size(ldz_bslZones) > 0
    for i = 0 to array.size(ldz_bslZones) - 1

        if array.get(ldz_bslActive, i)
            box zone = array.get(ldz_bslZones, i)
            float level = array.get(ldz_bslPrices, i)
            float zoneTop = box.get_top(zone)
            float zoneBottom = box.get_bottom(zone)

            if high > zoneTop and close < level
                ldz_bearishSweep := true
                array.set(ldz_bslActive, i, false)

                box.set_extend(zone, extend.none)
                box.set_right(zone, bar_index)
                box.set_bgcolor(zone, color.new(color.orange, 82))
                box.set_border_color(zone, color.orange)

                if ldz_showSweeps
                    label.new(
                         bar_index,
                         high,
                         "BSL SWEEP",
                         style=label.style_label_down,
                         color=color.orange,
                         textcolor=color.white,
                         size=size.small)

            else if close > zoneTop
                array.set(ldz_bslActive, i, false)
                box.set_extend(zone, extend.none)
                box.set_right(zone, bar_index)
                box.set_bgcolor(zone, color.new(color.gray, 90))
                box.set_border_color(zone, color.gray)

if array.size(ldz_sslZones) > 0
    for i = 0 to array.size(ldz_sslZones) - 1

        if array.get(ldz_sslActive, i)
            box zone = array.get(ldz_sslZones, i)
            float level = array.get(ldz_sslPrices, i)
            float zoneTop = box.get_top(zone)
            float zoneBottom = box.get_bottom(zone)

            if low < zoneBottom and close > level
                ldz_bullishSweep := true
                array.set(ldz_sslActive, i, false)

                box.set_extend(zone, extend.none)
                box.set_right(zone, bar_index)
                box.set_bgcolor(zone, color.new(color.aqua, 82))
                box.set_border_color(zone, color.aqua)

                if ldz_showSweeps
                    label.new(
                         bar_index,
                         low,
                         "SSL SWEEP",
                         style=label.style_label_up,
                         color=color.aqua,
                         textcolor=color.black,
                         size=size.small)

            else if close < zoneBottom
                array.set(ldz_sslActive, i, false)
                box.set_extend(zone, extend.none)
                box.set_right(zone, bar_index)
                box.set_bgcolor(zone, color.new(color.gray, 90))
                box.set_border_color(zone, color.gray)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 7. REVERSAL CONFIRMATION
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ldz_bullishCandle = close > open
ldz_bearishCandle = close < open

ldz_buySignal = ldz_bullishSweep and (not ldz_requireCandleColor or ldz_bullishCandle)
ldz_sellSignal = ldz_bearishSweep and (not ldz_requireCandleColor or ldz_bearishCandle)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 8. PLOT REVERSAL SIGNALS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

plotshape(
     ldz_showReversals and ldz_buySignal,
     title="Bullish Liquidity Reversal",
     style=shape.cross,
     location=location.belowbar,
     color=color.lime,
     text="BUY",
     textcolor=color.black,
     size=size.small)

plotshape(
     ldz_showReversals and ldz_sellSignal,
     title="Bearish Liquidity Reversal",
     style=shape.cross,
     location=location.abovebar,
     color=color.red,
     text="SELL",
     textcolor=color.white,
     size=size.small)

//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// 9. ALERTS
//━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

alertcondition(
     ldz_enableAlerts and ldz_bullishSweep,
     title="Sell-Side Liquidity Sweep",
     message="LDZ [JPT]: Sell-side liquidity swept. Price moved below a liquidity zone and closed back above its swing level.")

alertcondition(
     ldz_enableAlerts and ldz_bearishSweep,
     title="Buy-Side Liquidity Sweep",
     message="LDZ [JPT]: Buy-side liquidity swept. Price moved above a liquidity zone and closed back below its swing level.")

alertcondition(
     ldz_enableAlerts and ldz_buySignal,
     title="Bullish Liquidity Reversal",
     message="LDZ [JPT]: Bullish liquidity reversal confirmed.")

alertcondition(
     ldz_enableAlerts and ldz_sellSignal,
     title="Bearish Liquidity Reversal",
     message="LDZ [JPT]: Bearish liquidity reversal confirmed.")

// ══════════════════════════════════════════════════════════════════════════════════════════════════ //
//  AJOUT 7 — FVG Sessions [LuxAlgo]  © LuxAlgo (CC BY-NC-SA 4.0)
//  Code intact sauf : ligne pointillée verticale de séparation des sessions retirée.
//  Variables préfixées fs_ pour éviter les collisions (n, bullCss, bearCss… existent déjà).
// ══════════════════════════════════════════════════════════════════════════════════════════════════ //

//------------------------------------------------------------------------------
//Settings
//-----------------------------------------------------------------------------{
fs_bullCss          = input.color(color.teal, 'FVG Level'               , inline = 'fs_bull', group = 'FVG Sessions')
fs_bullAreaCss      = input.color(color.new(color.teal, 50), 'Area'     , inline = 'fs_bull', group = 'FVG Sessions')
fs_bullMitigatedCss = input.color(color.new(color.teal, 80), 'Mitigated', inline = 'fs_bull', group = 'FVG Sessions')

fs_bearCss          = input.color(color.red, 'FVG Level'                , inline = 'fs_bear', group = 'FVG Sessions')
fs_bearAreaCss      = input.color(color.new(color.red, 50), 'Area'      , inline = 'fs_bear', group = 'FVG Sessions')
fs_bearMitigatedCss = input.color(color.new(color.red, 80), 'Mitigated' , inline = 'fs_bear', group = 'FVG Sessions')

//-----------------------------------------------------------------------------}
//UDT's
//-----------------------------------------------------------------------------{
type fs_fvg
    float top
    float btm
    bool  mitigated
    bool  isnew
    bool  isbull
    line  lvl
    box   fs_area

type fs_session_range
    line fs_max
    line fs_min

//-----------------------------------------------------------------------------}
//Methods
//-----------------------------------------------------------------------------{
fs_n = bar_index

//Method for setting fair value gaps
method fs_set_fvg(fs_fvg id, offset, bg_css, l_css)=>
    fs_avg = math.avg(id.top, id.btm)

    fs_area  = box.new(fs_n - offset, id.top, fs_n, id.btm, na, bgcolor = bg_css)
    fs_avg_l = line.new(fs_n - offset, fs_avg, fs_n, fs_avg, color = l_css, style = line.style_dashed)

    id.lvl := fs_avg_l
    id.fs_area := fs_area

//Method for setting session range maximum/minimum
method fs_set_range(fs_session_range id)=>
    fs_max = math.max(high, id.fs_max.get_y2())
    fs_min = math.min(low, id.fs_min.get_y2())

    id.fs_max.set_xy2(fs_n, fs_max)
    id.fs_max.set_y1(fs_max)

    id.fs_min.set_xy2(fs_n, fs_min)
    id.fs_min.set_y1(fs_min)

//-----------------------------------------------------------------------------}
//Variables
//-----------------------------------------------------------------------------{
var fs_chartCss = color.new(chart.fg_color, 50)

var fs_fvg fs_sfvg = fs_fvg.new(na, na, na, true, na)
var fs_session_range fs_sesr = na

var box fs_area = na
var line fs_avg = na

fs_bull_fvg = low > high[2] and close[1] > high[2]
fs_bear_fvg = high < low[2] and close[1] < low[2]

//Alert conditions
fs_bull_isnew      = false
fs_bear_isnew      = false
fs_bull_mitigated  = false
fs_bear_mitigated  = false
fs_within_bull_fvg = false
fs_within_bear_fvg = false

//-----------------------------------------------------------------------------}
//New session
//-----------------------------------------------------------------------------{
fs_dtf = timeframe.change('D')

//On new session
if fs_dtf
    //Set new range
    fs_sesr := fs_session_range.new(
      line.new(fs_n, high, fs_n, high, color = fs_chartCss)
      , line.new(fs_n, low, fs_n, low, color = fs_chartCss))

    fs_sfvg.isnew := true

    //Set prior session fvg right coordinates
    if not na(fs_sfvg.lvl)
        fs_sfvg.lvl.set_x2(fs_n-2)
        fs_sfvg.fs_area.set_right(fs_n-2)

//Set range
else if not na(fs_sesr)
    fs_sesr.fs_set_range()

    //Set range lines color
    fs_sesr.fs_max.set_color(fs_sfvg.isbull ? fs_bullCss : fs_bearCss)
    fs_sesr.fs_min.set_color(fs_sfvg.isbull ? fs_bullCss : fs_bearCss)

//-----------------------------------------------------------------------------}
//Set FVG
//-----------------------------------------------------------------------------{
//New session bullish fvg
if fs_bull_fvg and fs_sfvg.isnew
    fs_sfvg := fs_fvg.new(low, high[2], false, false, true)
    fs_sfvg.fs_set_fvg(2, fs_bullAreaCss, fs_bullCss)

    fs_bull_isnew := true

//New session bearish fvg
else if fs_bear_fvg and fs_sfvg.isnew
    fs_sfvg := fs_fvg.new(low[2], high, false, false, false)
    fs_sfvg.fs_set_fvg(2, fs_bearAreaCss, fs_bearCss)

    fs_bear_isnew := true

//Change object transparencies if mitigated
if not fs_sfvg.mitigated
    //If session fvg is bullish
    if fs_sfvg.isbull and close < fs_sfvg.btm
        fs_sfvg.fs_set_fvg(1, fs_bullMitigatedCss, fs_bullCss)

        fs_sfvg.mitigated := true
        fs_bull_mitigated := true

    //If session fvg is bearish
    else if not fs_sfvg.isbull and close > fs_sfvg.top
        fs_sfvg.fs_set_fvg(1, fs_bearMitigatedCss, fs_bearCss)

        fs_sfvg.mitigated := true
        fs_bear_mitigated := true

//Set fvg right coordinates to current bar
if not fs_sfvg.isnew
    fs_sfvg.lvl.set_x2(fs_n)
    fs_sfvg.fs_area.set_right(fs_n)

//-----------------------------------------------------------------------------}
//Alerts
//-----------------------------------------------------------------------------{
//On new session fvg
alertcondition(fs_bull_isnew, 'Bullish FVG', 'New session bullish fvg')
alertcondition(fs_bear_isnew, 'Bearish FVG', 'New session bearish fvg')

//On fvg mitigation
alertcondition(fs_bull_mitigated, 'Mitigated Bullish FVG', 'Session bullish fvg has been mitigated')
alertcondition(fs_bear_mitigated, 'Mitigated Bearish FVG', 'Session bearish fvg has been mitigated')

//If within fvg
alertcondition(close >= fs_sfvg.btm and close <= fs_sfvg.top and fs_sfvg.isbull and not fs_sfvg.isnew
  , 'Price Within Bullish FVG'
  , 'Price is within bullish fvg')

alertcondition(close >= fs_sfvg.btm and close <= fs_sfvg.top and not fs_sfvg.isbull and not fs_sfvg.isnew
  , 'Price Within Bearish FVG'
  , 'Price is within bearish fvg')

//On fvg average cross
alertcondition(ta.cross(close, math.avg(fs_sfvg.top, fs_sfvg.btm)) and fs_sfvg.isbull and not fs_sfvg.isnew
  , 'Bullish FVG AVG Cross'
  , 'Price crossed bullish fvg average')

alertcondition(ta.cross(close, math.avg(fs_sfvg.top, fs_sfvg.btm)) and not fs_sfvg.isbull and not fs_sfvg.isnew
  , 'Bearish FVG AVG Cross'
  , 'Price crossed bearish fvg average')

//-----------------------------------------------------------------------------}

